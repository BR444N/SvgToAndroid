---
// Toast.astro: Notificaciones emergentes redondeadas en blanco y negro
---
<div
  id="toastContainer"
  class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"
>
</div>

<script>
  window.addEventListener('app:toast', ((event: CustomEvent<{ message: string; type: 'success' | 'error' | 'info' }>) => {
    const container = document.getElementById('toastContainer');
    if (!container) return;

    const { message, type } = event.detail;
    const toast = document.createElement('div');
    toast.className =
      'pointer-events-auto flex items-center gap-3 px-5 py-2.5 rounded-full shadow-2xl border border-white/15 bg-black/90 backdrop-blur-xl text-white text-xs font-medium transition-all duration-300 transform translate-y-3 opacity-0';

    const iconSvg =
      type === 'success'
        ? '<svg class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>'
        : type === 'error'
        ? '<svg class="w-4 h-4 text-white/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>'
        : '<svg class="w-4 h-4 text-white/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';

    toast.innerHTML = `${iconSvg}<span>${message}</span>`;
    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-3', 'opacity-0');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 2800);
  }) as EventListener);
</script>
