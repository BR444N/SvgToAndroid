---
// SEOHead.astro: Metadatos completos para indexación en motores de búsqueda, redes sociales y PWA
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "SVG to Android Vector Converter | Convert SVG to XML Online Free",
  description = "Convert SVG files into Android Vector Drawable (.xml) instantly. Free, secure, 100% client-side tool for Android Studio and Jetpack Compose with interactive preview and ZIP batch download.",
  canonicalUrl = "https://svg-to-android.vercel.app/",
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SVG to Android Vector Converter",
  "url": canonicalUrl,
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Convert SVG to Android Vector Drawable XML",
    "100% client-side in-browser conversion without file uploads",
    "Interactive extended preview with zoom controls (+, -, reset)",
    "Individual and batch ZIP download",
    "Instant 1-click XML copy ready for Android Studio"
  ]
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="svg to android, svg to xml, android vector drawable, vector drawable converter, svg2vectordrawable, jetpack compose icons, convert svg to android xml, android drawable generator, android studio xml" />
<meta name="author" content="BR444N" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalUrl} />

<!-- Theme & Mobile Settings -->
<meta name="theme-color" content="#000000" />
<meta name="color-scheme" content="dark" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="https://svg-to-android.vercel.app/favicon.svg" />
<meta property="og:site_name" content="SVG to Android Vector Converter" />
<meta property="og:locale" content="en_US" />
<meta property="og:locale:alternate" content="es_ES" />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content="https://svg-to-android.vercel.app/favicon.svg" />

<!-- JSON-LD Structured Data (Schema.org) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
