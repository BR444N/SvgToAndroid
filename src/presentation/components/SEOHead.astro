---
// SEOHead.astro: Metadatos completos para indexación en motores de búsqueda, redes sociales y PWA
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "SVG to Android Vector Converter | Convierte SVG a XML Gratis",
  description = "Convierte archivos SVG a Android Vector Drawable (.xml) al instante. Herramienta online, segura y 100% en el navegador para Android Studio y Jetpack Compose con vista previa y descarga ZIP.",
  canonicalUrl = "https://svgtoandroid.dev/",
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SVG to Android Vector Converter",
  "url": canonicalUrl,
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Conversión de SVG a Android Vector Drawable XML",
    "Procesamiento 100% en el navegador sin subir archivos",
    "Vista previa ampliada con controles de zoom (+, -, restablecer)",
    "Descarga individual y masiva en formato ZIP",
    "Copiado de código XML listo para pegar en Android Studio"
  ]
};
---

<!-- Metadatos Primarios -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="svg to android, svg to xml, android vector drawable, vector drawable converter, svg2vectordrawable, jetpack compose icons, convert svg to android xml, svg a vector android, android drawable generator, android studio xml" />
<meta name="author" content="SVG to Android" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalUrl} />

<!-- Configuración de Tema y Pantalla Móvil -->
<meta name="theme-color" content="#000000" />
<meta name="color-scheme" content="dark" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="https://svgtoandroid.dev/favicon.svg" />
<meta property="og:site_name" content="SVG to Android Vector Converter" />
<meta property="og:locale" content="es_ES" />
<meta property="og:locale:alternate" content="en_US" />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content="https://svgtoandroid.dev/favicon.svg" />

<!-- Datos Estructurados JSON-LD (Schema.org para Google Search & Rich Snippets) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
