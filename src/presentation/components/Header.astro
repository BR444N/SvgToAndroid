---
// Header.astro: Navbar flotante que se auto-oculta suavemente al desplazarse
---
<nav
  id="floatingNavbar"
  class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-40 w-[calc(100%-2rem)] max-w-4xl transition-all duration-300 ease-in-out transform translate-y-0 opacity-100"
>
  <div class="flex items-center justify-between px-5 sm:px-6 py-2.5 rounded-full bg-black/80 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/90">
    <div class="flex items-center gap-3">
      <!-- Logo de la app directamente desde favicon.svg sin formas sobrepuestas -->
      <img
        src="/favicon.svg"
        alt="Logo SVG to Android"
        class="w-8 h-8 sm:w-9 sm:h-9 object-contain shrink-0"
      />

      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold text-white tracking-tight">SVG to Android</span>
        <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-white/10 text-white/80 border border-white/10 font-mono">
          XML
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs text-white/50 hidden sm:inline-block">Vector Drawable Tool</span>
      <div class="w-2 h-2 rounded-full bg-white animate-pulse"></div>
    </div>
  </div>
</nav>
