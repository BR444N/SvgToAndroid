---
// Header.astro: Navbar flotante con selector de idioma (EN/ES) con persistencia
---
<nav
  id="floatingNavbar"
  class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-40 w-[calc(100%-2rem)] max-w-4xl transition-all duration-300 ease-in-out transform translate-y-0 opacity-100"
>
  <div class="flex items-center justify-between px-5 sm:px-6 py-2.5 rounded-full bg-black/80 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/90">
    <div class="flex items-center gap-3">
      <!-- Logo de la app directamente desde favicon.svg sin formas sobrepuestas -->
      <img
        src="/favicon.svg"
        alt="Logo SVG to Android"
        class="w-8 h-8 sm:w-9 sm:h-9 object-contain shrink-0"
      />

      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold text-white tracking-tight" data-i18n="nav.title">SVG to Android</span>
        <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-white/10 text-white/80 border border-white/10 font-mono" data-i18n="nav.badge">
          XML
        </span>
      </div>
    </div>

    <!-- Lado derecho: Enlace GitHub, Selector de Idioma (Dropdown) y Estado -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Enlace al repositorio GitHub -->
      <a
        href="https://github.com/BR444N/SvgToAndroid"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        title="GitHub Repository"
        class="flex items-center justify-center w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 text-white/70 hover:text-white border border-white/10 hover:border-white/20 transition-all cursor-pointer"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <div class="relative">
        <!-- Botón Trigger del Dropdown de Idiomas -->
        <button
          id="langDropdownBtn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 text-white/80 hover:text-white border border-white/10 hover:border-white/20 text-xs font-mono font-medium transition-all cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <!-- Icono Mundo / Idioma -->
          <svg class="w-3.5 h-3.5 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span id="currentLangLabel">EN</span>
          <!-- Flecha Chevron abajo -->
          <svg class="w-3 h-3 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Menú Dropdown Flotante -->
        <div
          id="langDropdownMenu"
          class="hidden absolute right-0 mt-2 w-36 rounded-2xl bg-black/95 border border-white/15 p-1.5 shadow-2xl backdrop-blur-2xl z-50 transform origin-top-right transition-all"
        >
          <button
            type="button"
            data-lang="en"
            class="lang-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs text-left font-medium text-white/70 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
          >
            <span>English</span>
            <span class="text-[10px] font-mono text-white/40">EN</span>
          </button>
          <button
            type="button"
            data-lang="es"
            class="lang-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs text-left font-medium text-white/70 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
          >
            <span>Español</span>
            <span class="text-[10px] font-mono text-white/40">ES</span>
          </button>
        </div>
      </div>

      <div class="w-2 h-2 rounded-full bg-white animate-pulse" title="Online"></div>
    </div>
  </div>
</nav>
