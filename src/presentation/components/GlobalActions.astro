---
// GlobalActions.astro
---
<div id="globalActionsSection" class="hidden flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/60 border border-slate-800 transition-all duration-300">
  <div class="flex items-center gap-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total:</span>
      <span id="totalBadge" class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-200 border border-slate-700">0</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Convertidos:</span>
      <span id="convertedBadge" class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">0</span>
    </div>
    <div id="errorBadgeContainer" class="hidden items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-rose-400">Rechazados:</span>
      <span id="errorBadge" class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20">0</span>
    </div>
  </div>

  <div class="flex items-center gap-3 w-full sm:w-auto">
    <!-- Botón Descargar Todos en ZIP -->
    <button
      id="btnExportZip"
      type="button"
      class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm shadow-lg shadow-emerald-500/20 transition-all duration-200 active:scale-95"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      <span>Descargar Todos (.ZIP)</span>
    </button>

    <!-- Botón Limpiar Todo -->
    <button
      id="btnClearAll"
      type="button"
      class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700/80 text-slate-300 hover:text-rose-400 font-medium text-sm border border-slate-700/70 transition-all duration-200"
      title="Eliminar todos los archivos"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      <span>Limpiar</span>
    </button>
  </div>
</div>
