---
// Dropzone.astro: Zona de carga minimalista en blanco y negro con bordes redondeados y sin referencias de seguridad
---
<div class="w-full">
  <div
    id="dropzone"
    class="relative group border border-dashed border-white/15 hover:border-white/40 bg-black/50 hover:bg-black/80 rounded-3xl p-8 sm:p-12 text-center transition-all duration-300 cursor-pointer overflow-hidden backdrop-blur-md shadow-2xl"
  >
    <!-- Input oculto para selección de archivos -->
    <input
      type="file"
      id="fileInput"
      multiple
      accept=".svg,image/svg+xml"
      class="hidden"
    />

    <div class="relative z-10 flex flex-col items-center justify-center space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white group-hover:scale-105 group-hover:border-white/30 group-hover:bg-white/10 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>

      <div class="space-y-1.5">
        <p class="text-base font-medium text-white">
          Arrastra y suelta tus archivos <span class="font-semibold underline decoration-white/40 underline-offset-4">SVG</span> aquí
        </p>
        <p class="text-xs sm:text-sm text-white/50">
          o haz clic para explorar en tu equipo
        </p>
      </div>
    </div>

    <!-- Barra de progreso secuencial minimalista -->
    <div id="queueProgressContainer" class="hidden absolute bottom-0 left-0 right-0 h-1 bg-white/10 overflow-hidden">
      <div id="queueProgressBar" class="h-full bg-white transition-all duration-200" style="width: 0%"></div>
    </div>
  </div>
</div>
