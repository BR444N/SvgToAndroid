---
import Header from '../presentation/components/Header.astro';
import Dropzone from '../presentation/components/Dropzone.astro';
import GlobalActions from '../presentation/components/GlobalActions.astro';
import Toast from '../presentation/components/Toast.astro';
import SpaceBackground from '../presentation/components/SpaceBackground.astro';
import '../presentation/styles/global.css';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Conversor minimalista de SVG a Android Vector Drawable XML en el navegador." />
    <title>SVG to Android Vector</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-black text-white flex flex-col min-h-screen relative overflow-x-hidden selection:bg-white selection:text-black">
    <!-- Fondo estelar del espacio con dots de 2px y destellos lentos -->
    <SpaceBackground />

    <!-- Navbar Flotante -->
    <Header />

    <!-- Contenedor Principal (con espacio superior para el navbar flotante) -->
    <main class="relative z-10 flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 pt-24 sm:pt-28 pb-16 space-y-6">
      <!-- Encabezado Principal -->
      <div class="text-center space-y-2 pt-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white">
          SVG to Android Vector
        </h1>
        <p class="text-sm sm:text-base text-white/50 max-w-lg mx-auto font-light">
          Convierte tus archivos vectoriales al formato XML de Android al instante.
        </p>
      </div>

      <!-- Zona de Carga (Dropzone redondeado) -->
      <Dropzone />

      <!-- Barra de Acciones Globales (Descarga ZIP, Limpieza, Contadores) -->
      <GlobalActions />

      <!-- Lista Dinámica de Archivos Procesados -->
      <section class="space-y-4">
        <!-- Contenedor de Tarjetas Renderizadas por TypeScript -->
        <div id="filesListContainer" class="space-y-3.5"></div>

        <!-- Estado Vacío Informativo -->
        <div
          id="emptyState"
          class="rounded-3xl border border-dashed border-white/10 bg-black/40 backdrop-blur-md p-10 sm:p-12 text-center space-y-3"
        >
          <div class="w-12 h-12 mx-auto rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/40">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm font-medium text-white/80">Ningún archivo cargado</h3>
            <p class="text-xs text-white/40 max-w-xs mx-auto">
              Arrastra tus iconos o gráficos en formato SVG para visualizarlos, copiar el código o descargarlos.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- Notificaciones Toast -->
    <Toast />

    <!-- Script de Inicialización TypeScript (MVP Presenter) -->
    <script>
      import { bootstrapApp } from '../presentation/presenters/AppBootstrap';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => bootstrapApp());
      } else {
        bootstrapApp();
      }
    </script>
  </body>
</html>
