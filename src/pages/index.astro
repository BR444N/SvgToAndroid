---
import Header from '../presentation/components/Header.astro';
import Dropzone from '../presentation/components/Dropzone.astro';
import GlobalActions from '../presentation/components/GlobalActions.astro';
import Toast from '../presentation/components/Toast.astro';
import '../presentation/styles/global.css';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Conversor seguro y rápido de SVG a Android Vector Drawable XML en el navegador." />
    <title>SVG to Android Vector Converter | Astro + TypeScript</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-slate-950 text-slate-100 flex flex-col min-h-screen">
    <Header />

    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
      <!-- Encabezado de la Herramienta -->
      <div class="text-center space-y-3">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Convierte tus SVG a <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Android Vector XML</span>
        </h2>
        <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto">
          Optimizado para el desarrollo Android en Jetpack Compose y XML Drawables tradicionales. Procesamiento seguro, instantáneo y 100% local en tu navegador.
        </p>
      </div>

      <!-- Zona de Carga (Dropzone con validación estricta) -->
      <Dropzone />

      <!-- Barra de Acciones Globales (Descarga ZIP, Limpieza, Contadores) -->
      <GlobalActions />

      <!-- Lista Dinámica de Archivos Procesados -->
      <section class="space-y-4">
        <!-- Contenedor de Tarjetas Renderizadas por TypeScript -->
        <div id="filesListContainer" class="space-y-3"></div>

        <!-- Estado Vacío Informativo -->
        <div
          id="emptyState"
          class="rounded-2xl border border-dashed border-slate-800/80 bg-slate-900/20 p-10 text-center space-y-4"
        >
          <div class="w-12 h-12 mx-auto rounded-full bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-500">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm font-medium text-slate-300">Ningún archivo cargado todavía</h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto">
              Arrastra tus iconos o imágenes en formato .svg para visualizarlos, copiar el código o descargarlos.
            </p>
          </div>
        </div>
      </section>

      <!-- Panel Informativo de Medidas de Seguridad y Funcionalidades -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-6 border-t border-slate-900 text-xs text-slate-400">
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 space-y-1.5">
          <div class="flex items-center gap-2 text-emerald-400 font-semibold">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Seguridad en 4 Capas</span>
          </div>
          <p>Validación estricta de MIME, extensión, XML bien formado y sanitización automática contra scripts maliciosos (XSS/XXE).</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 space-y-1.5">
          <div class="flex items-center gap-2 text-teal-400 font-semibold">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>100% Client-Side</span>
          </div>
          <p>Tus archivos nunca viajan por internet ni se guardan en ningún servidor externo. Máxima privacidad y velocidad instantánea.</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 space-y-1.5">
          <div class="flex items-center gap-2 text-sky-400 font-semibold">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span>Listo para Android</span>
          </div>
          <p>Nombres formateados en <code>ic_nombre.xml</code> y etiquetas compatibles con Android Vector Drawable y Jetpack Compose.</p>
        </div>
      </section>
    </main>

    <!-- Notificaciones Toast -->
    <Toast />

    <!-- Script de Inicialización TypeScript (MVP Presenter) -->
    <script>
      import { bootstrapApp } from '../presentation/presenters/AppBootstrap';

      // Inicializar cuando el DOM esté listo
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => bootstrapApp());
      } else {
        bootstrapApp();
      }
    </script>
  </body>
</html>
